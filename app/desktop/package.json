{
  "name": "@sprint/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "type-check": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "tsx --test \"electron/*.test.ts\" \"src/**/*.test.ts\"",
    "start": "electron .",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@sprint/dashboard": "workspace:*",
    "@sprint/tokens": "workspace:*",
    "@sprint/types": "workspace:*",
    "electron-updater": "6.8.11",
    "lucide-react": "^1.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "8.3.5"
  }
}
