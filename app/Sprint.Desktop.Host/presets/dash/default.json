{
  "id": "default",
  "name": "Driver Focus",
  "default": true,
  "mode": "basic",
  "dashStyle": "panels",
  "gridCols": 20,
  "gridRows": 12,
  "idlePage": {
    "id": "idle-default",
    "name": "Idle",
    "widgets": [
      {"id": "idle-name", "type": "text", "col": 4, "row": 3, "colSpan": 12, "rowSpan": 3, "config": {"content": "Your Name", "binding": "profile.driverName"}},
      {"id": "idle-number", "type": "text", "col": 7, "row": 6, "colSpan": 6, "rowSpan": 2, "style": {"textColor": "ember"}, "config": {"content": "#22", "binding": "profile.driverNumber"}}
    ]
  },
  "pages": [
    {
      "id": "race-default",
      "name": "Race",
      "widgets": [
        {"id": "race-last", "type": "lap_time", "col": 0, "row": 0, "colSpan": 6, "rowSpan": 3, "config": {"show": "last"}},
        {"id": "race-delta", "type": "delta", "col": 6, "row": 0, "colSpan": 8, "rowSpan": 3},
        {"id": "race-best", "type": "lap_time", "col": 14, "row": 0, "colSpan": 6, "rowSpan": 3, "config": {"show": "best"}},
        {"id": "race-tyres", "type": "tyre_temp", "col": 0, "row": 3, "colSpan": 6, "rowSpan": 6},
        {"id": "race-gear", "type": "gear_speed", "col": 6, "row": 3, "colSpan": 8, "rowSpan": 6},
        {"id": "race-tc", "type": "tc", "col": 14, "row": 3, "colSpan": 3, "rowSpan": 3},
        {"id": "race-abs", "type": "abs", "col": 17, "row": 3, "colSpan": 3, "rowSpan": 3},
        {"id": "race-bias", "type": "brake_bias", "col": 14, "row": 6, "colSpan": 3, "rowSpan": 3},
        {"id": "race-map", "type": "engine_map", "col": 17, "row": 6, "colSpan": 3, "rowSpan": 3},
        {"id": "race-ahead", "type": "gaps", "col": 0, "row": 9, "colSpan": 6, "rowSpan": 3, "config": {"side": "ahead"}},
        {"id": "race-fuel", "type": "fuel", "col": 6, "row": 9, "colSpan": 8, "rowSpan": 3},
        {"id": "race-behind", "type": "gaps", "col": 14, "row": 9, "colSpan": 6, "rowSpan": 3, "config": {"side": "behind"}}
      ]
    },
    {
      "id": "endurance-default",
      "name": "Endurance",
      "widgets": [
        {"id": "endurance-energy", "type": "virtual_energy", "col": 0, "row": 0, "colSpan": 7, "rowSpan": 3, "config": {"mode": "budget"}},
        {"id": "endurance-fuel", "type": "fuel", "col": 7, "row": 0, "colSpan": 7, "rowSpan": 3},
        {"id": "endurance-fuel-target", "type": "fuel_target", "col": 14, "row": 0, "colSpan": 6, "rowSpan": 3},
        {"id": "endurance-position", "type": "position", "col": 0, "row": 3, "colSpan": 6, "rowSpan": 3},
        {"id": "endurance-gaps", "type": "gaps", "col": 0, "row": 6, "colSpan": 6, "rowSpan": 3},
        {"id": "endurance-gear", "type": "gear_speed", "col": 6, "row": 3, "colSpan": 8, "rowSpan": 6},
        {"id": "endurance-delta", "type": "delta", "col": 14, "row": 3, "colSpan": 6, "rowSpan": 3},
        {"id": "endurance-last", "type": "lap_time", "col": 14, "row": 6, "colSpan": 6, "rowSpan": 3, "config": {"show": "last"}},
        {"id": "endurance-tc", "type": "tc", "col": 0, "row": 9, "colSpan": 5, "rowSpan": 3},
        {"id": "endurance-abs", "type": "abs", "col": 5, "row": 9, "colSpan": 5, "rowSpan": 3},
        {"id": "endurance-bias", "type": "brake_bias", "col": 10, "row": 9, "colSpan": 5, "rowSpan": 3},
        {"id": "endurance-map", "type": "engine_map", "col": 15, "row": 9, "colSpan": 5, "rowSpan": 3}
      ]
    },
    {
      "id": "tyres-default",
      "name": "Tyres",
      "widgets": [
        {"id": "tyres-temps", "type": "tyre_temp", "col": 0, "row": 0, "colSpan": 8, "rowSpan": 9},
        {"id": "tyres-gear", "type": "gear_speed", "col": 8, "row": 0, "colSpan": 4, "rowSpan": 9},
        {"id": "tyres-pressures", "type": "tyre_pressure", "col": 12, "row": 0, "colSpan": 8, "rowSpan": 9},
        {"id": "tyres-tc", "type": "tc", "col": 0, "row": 9, "colSpan": 4, "rowSpan": 3},
        {"id": "tyres-abs", "type": "abs", "col": 4, "row": 9, "colSpan": 4, "rowSpan": 3},
        {"id": "tyres-bias", "type": "brake_bias", "col": 8, "row": 9, "colSpan": 4, "rowSpan": 3},
        {"id": "tyres-fuel", "type": "fuel", "col": 12, "row": 9, "colSpan": 4, "rowSpan": 3},
        {"id": "tyres-delta", "type": "delta", "col": 16, "row": 9, "colSpan": 4, "rowSpan": 3}
      ]
    },
    {
      "id": "qualifying-default",
      "name": "Qualifying",
      "widgets": [
        {"id": "qualifying-delta", "type": "delta", "col": 0, "row": 0, "colSpan": 20, "rowSpan": 3},
        {"id": "qualifying-gear", "type": "gear_speed", "col": 0, "row": 3, "colSpan": 5, "rowSpan": 6},
        {"id": "qualifying-predicted", "type": "predictive_lap", "col": 5, "row": 3, "colSpan": 8, "rowSpan": 6},
        {"id": "qualifying-tyres", "type": "tyre_temp", "col": 13, "row": 3, "colSpan": 7, "rowSpan": 6},
        {"id": "qualifying-sectors", "type": "sector", "col": 0, "row": 9, "colSpan": 10, "rowSpan": 3},
        {"id": "qualifying-last", "type": "lap_time", "col": 10, "row": 9, "colSpan": 5, "rowSpan": 3, "config": {"show": "last"}},
        {"id": "qualifying-best", "type": "lap_time", "col": 15, "row": 9, "colSpan": 5, "rowSpan": 3, "config": {"show": "best"}}
      ]
    }
  ],
  "alerts": [
    {"id": "alert-tc", "type": "tc_change", "col": 6, "row": 3, "colSpan": 8, "rowSpan": 6},
    {"id": "alert-abs", "type": "abs_change", "col": 6, "row": 3, "colSpan": 8, "rowSpan": 6},
    {"id": "alert-bias", "type": "bias_change", "col": 6, "row": 3, "colSpan": 8, "rowSpan": 6},
    {"id": "alert-engine-map", "type": "enginemap_change", "col": 6, "row": 3, "colSpan": 8, "rowSpan": 6},
    {"id": "alert-lap-summary", "type": "lap_summary", "col": 0, "row": 0, "colSpan": 20, "rowSpan": 12}
  ],
  "alertConfig": {
    "displayMode": "full",
    "durationSeconds": 1.5,
    "colorToken": "auto",
    "invertColors": false
  }
}
