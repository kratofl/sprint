<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sprint.Desktop</RootNamespace>
    <AssemblyName>Sprint.Desktop.Client</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- WS10: intentional Windows-first publish target. Framework-dependent (the
         .NET 10 desktop runtime is a prerequisite) → small artifacts; flip
         SelfContained to true for a standalone build. `make build-app` publishes
         to app/build/bin. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>Sprint Desktop</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <!-- Pinned to the exact version Avalonia 12.0.5 already resolves transitively
         (via Avalonia.Skia), so no new native assets or version conflict. The dash
         painter renders off the UI thread to a pixel buffer that feeds both the
         on-screen preview and hardware (WS6/WS7). -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sprint.Desktop.Api\Sprint.Desktop.Api.csproj" />
    <ProjectReference Include="..\Sprint.Games\Sprint.Games.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="presets\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="build\appicon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
