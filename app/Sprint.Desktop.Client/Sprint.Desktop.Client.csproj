<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sprint.Desktop</RootNamespace>
    <AssemblyName>Sprint.Desktop.Client</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Cross-platform publish targets (Windows + Linux x64). Dev build/run/test
         stay framework-dependent; the single-file profile below makes `publish`
         self-contained so shipped binaries need NO installed .NET runtime. -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>Sprint Desktop</AssemblyTitle>
  </PropertyGroup>

  <!-- Lightweight, self-contained, single-file publish (one binary, no runtime
       dependency), applied whenever PublishSingleFile is requested — i.e.
       `make build-app` and the release workflow. Native libs (SkiaSharp/Avalonia)
       are bundled and the payload is compressed. Trimming + Native AOT would shrink
       this further but need System.Text.Json source generators + a per-OS GUI smoke
       first (our persistence uses reflection-based JSON) — see docs/RELEASE.md. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- The SkiaSharp/HarfBuzz runtime packs copy 100+ MB of native .pdb debug
       symbols into publish output; strip every .pdb from a shipping (single-file)
       publish so the artifact stays lightweight. -->
  <Target Name="StripPublishPdbs" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_PublishPdb Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishPdb)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <!-- Pinned to the exact version Avalonia 12.1.0 already resolves transitively
         (via Avalonia.Skia), so no new native assets or version conflict. The dash
         painter renders off the UI thread to a pixel buffer that feeds both the
         on-screen preview and hardware (WS6/WS7). -->
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sprint.Desktop.Api\Sprint.Desktop.Api.csproj" />
    <ProjectReference Include="..\Sprint.Games\Sprint.Games.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="presets\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="build\appicon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
