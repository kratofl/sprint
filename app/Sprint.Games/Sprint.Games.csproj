<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sprint.Games</RootNamespace>
    <AssemblyName>Sprint.Games</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sprint.Desktop.Api\Sprint.Desktop.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Written by app/desktop/scripts/sync-track-data.mjs; read by GamePitLossCatalog. -->
    <EmbeddedResource Include="LeMansUltimate\lmu-pit-loss.json" LogicalName="Sprint.Games.LeMansUltimate.lmu-pit-loss.json" />
  </ItemGroup>
</Project>
