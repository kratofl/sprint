{
  "name": "@sprint/desktop",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "pnpm --filter @sprint/ui... build",
    "dev": "vite",
    "prebuild": "pnpm --filter @sprint/ui... build",
    "build": "tsc -b && vite build",
    "lint": "eslint src --ext ts,tsx",
    "pretype-check": "pnpm --filter @sprint/ui... build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sprint/tokens": "workspace:*",
    "@sprint/types": "workspace:*",
    "@sprint/ui": "workspace:*",
    "@tabler/icons-react": "^3.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  }
}
