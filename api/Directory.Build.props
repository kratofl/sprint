<Project>

  <!--
    Shared MSBuild properties for the .NET API projects under api/.
    Mirrors app/Directory.Build.props (which is scoped to app/ and does not reach
    here). Version metadata is overridable from the command line, e.g. the Makefile
    passes -p:InformationalVersion=$(VERSION).
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Product>Sprint</Product>
    <Company>Sprint</Company>
    <Authors>Sprint</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
