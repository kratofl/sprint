# Docker build context excludes. The api image needs the .NET server (api/) plus
# the shared contract libs (app/Sprint.Contracts, app/Sprint.Desktop.Api) and
# global.json; the web image needs the pnpm workspace (package.json, pnpm-*.yaml,
# web/, packages/). Everything below is dead weight in the context (slower builds,
# larger cache) or must never be baked into an image.

# Version control & CI
.git
.github
.gitignore

# Tooling caches
.turbo
**/.turbo

# Node / web build output (rebuilt inside the image)
**/node_modules
web/.next
web/out
**/dist

# TypeScript incremental build info. These are gitignored, so a fresh clone never
# has them — but a build from a working copy would copy them in, and `composite`
# projects then trust the stale info, emit nothing, and leave dist/ empty.
**/*.tsbuildinfo

# Desktop app — NOT containerized. The API image only needs the shared contract
# libs (Sprint.Contracts + Sprint.Desktop.Api) and the web image none of app/, so
# exclude the desktop-only projects and publish output.
app/desktop/
app/frontend/
app/Sprint.Desktop.Core/
app/Sprint.Desktop.Host/
app/Sprint.Games/
app/Sprint.Desktop.Tests/
app/build/

# Not needed by any image
deploy/
docs/

# Local build artifacts
bin/
**/bin/
**/obj/

# Local env & logs (never bake secrets into an image)
.env
.env.local
api/Sprint.Api/appsettings.Development.json
*.log
bash.exe.stackdump

# Agent / session scratch
handoffs/
docs/superpowers/plans/
output/

# OS cruft
.DS_Store
Thumbs.db
