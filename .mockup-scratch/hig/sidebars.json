ed representation of the top portion of a window's sidebar displaying a section and some folders. The image is tinted red to subtly reflect the red in the original six-color Apple logo.","identifier":"components-sidebar-intro.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.HIG\/components-sidebar-intro@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.HIG\/components-sidebar-intro~dark@2x.png"}]},"components-sidebars-thumbnail.png":{"alt":"A stylized representation of a portion of a window's sidebar displaying a section and some folders. The image is tinted red to subtly reflect the red in the original six-color Apple logo.","identifier":"components-sidebars-thumbnail.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.HIG\/components-sidebars-thumbnail@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.HIG\/components-sidebars-thumbnail~dark@2x.png"}]},"components-split-views-thumbnail.png":{"alt":"A stylized representation of a window consisting of three areas: a sidebar, a canvas, and an inspector. The image is tinted red to subtly reflect the red in the original six-color Apple logo.","identifier":"components-split-views-thumbnail.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.HIG\/components-split-views-thumbnail@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.HIG\/components-split-views-thumbnail~dark@2x.png"}]},"components-tab-bars-thumbnail.png":{"alt":"A stylized representation of a tab bar containing three placeholder icons with names. The image is tinted red to subtly reflect the red in the original six-color Apple logo.","identifier":"components-tab-bars-thumbnail.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.HIG\/components-tab-bars-thumbnail@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.HIG\/components-tab-bars-thumbnail~dark@2x.png"}]},"components.png":{"alt":"","identifier":"components.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.HIG\/components@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.HIG\/components~dark@2x.png"}]},"crossout.png":{"alt":"An X in a circle to indicate incorrect usage.","identifier":"crossout.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.HIG\/crossout@2x.png"}]},"doc://com.apple.HIG/design/Human-Interface-Guidelines/color#App-accent-colors":{"abstract":[],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/color#App-accent-colors","kind":"section","title":"App accent colors","type":"topic","url":"\/design\/human-interface-guidelines\/color#App-accent-colors"},"doc://com.apple.HIG/design/Human-Interface-Guidelines/components":{"abstract":[{"text":"Learn how to use and customize system-defined components to give people a familiar and consistent experience.","type":"text"}],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/components","images":[{"identifier":"overview.svg","type":"icon"},{"identifier":"components.png","type":"card"}],"kind":"article","role":"collectionGroup","title":"Components","type":"topic","url":"\/design\/human-interface-guidelines\/components"},"doc://com.apple.HIG/design/Human-Interface-Guidelines/disclosure-controls":{"abstract":[{"text":"Disclosure controls reveal and hide information and functionality related to specific controls or views.","type":"text"}],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/disclosure-controls","images":[{"identifier":"components-disclosure-controls-thumbnail.png","type":"card"}],"kind":"article","role":"article","title":"Disclosure controls","type":"topic","url":"\/design\/human-interface-guidelines\/disclosure-controls"},"doc://com.apple.HIG/design/Human-Interface-Guidelines/layout":{"abstract":[{"text":"A consistent layout that adapts across display sizes, orientations, and multitasking configurations helps people understand and enjoy your app or game on all their devices.","type":"text"}],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/layout","images":[{"identifier":"layout.svg","type":"icon"},{"identifier":"foundations-layout-thumbnail.png","type":"card"}],"kind":"article","role":"article","title":"Layout","type":"topic","url":"\/design\/human-interface-guidelines\/layout"},"doc://com.apple.HIG/design/Human-Interface-Guidelines/materials#Liquid-Glass":{"abstract":[],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/materials#Liquid-Glass","kind":"section","title":"Liquid Glass","type":"topic","url":"\/design\/human-interface-guidelines\/materials#Liquid-Glass"},"doc://com.apple.HIG/design/Human-Interface-Guidelines/navigation-and-search":{"abstract":[],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/navigation-and-search","images":[{"identifier":"navigation-and-search.svg","type":"icon"},{"identifier":"components-navigation-and-search-thumbnail.png","type":"card"}],"kind":"article","role":"collectionGroup","title":"Navigation and search","type":"topic","url":"\/design\/human-interface-guidelines\/navigation-and-search"},"doc://com.apple.HIG/design/Human-Interface-Guidelines/sf-symbols":{"abstract":[{"text":"SF Symbols provides thousands of consistent, highly configurable symbols that integrate seamlessly with the San Francisco system font, automatically aligning with text in all weights and sizes.","type":"text"}],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/sf-symbols","images":[{"identifier":"sf-symbols.svg","type":"icon"},{"identifier":"foundations-sf-symbols-thumbnail.png","type":"card"}],"kind":"article","role":"article","title":"SF Symbols","type":"topic","url":"\/design\/human-interface-guidelines\/sf-symbols"},"doc://com.apple.HIG/design/Human-Interface-Guidelines/sf-symbols#Custom-symbols":{"abstract":[],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/sf-symbols#Custom-symbols","kind":"section","title":"Custom symbols","type":"topic","url":"\/design\/human-interface-guidelines\/sf-symbols#Custom-symbols"},"doc://com.apple.HIG/design/Human-Interface-Guidelines/split-views":{"abstract":[{"text":"A split view manages the presentation of multiple adjacent panes of content, each of which can contain a variety of components, including tables, collections, images, and custom views.","type":"text"}],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/split-views","images":[{"identifier":"components-split-views-thumbnail.png","type":"card"}],"kind":"article","role":"article","title":"Split views","type":"topic","url":"\/design\/human-interface-guidelines\/split-views"},"doc://com.apple.HIG/design/Human-Interface-Guidelines/tab-bars":{"abstract":[{"text":"A tab bar lets people navigate between top-level sections of your app.","type":"text"}],"identifier":"doc:\/\/com.apple.HIG\/design\/Human-Interface-Guidelines\/tab-bars","images":[{"identifier":"components-tab-bars-thumbnail.png","type":"card"}],"kind":"article","role":"article","title":"Tab bars","type":"topic","url":"\/design\/human-interface-guidelines\/tab-bars"},"doc://com.apple.HIG/design/human-interface-guidelines":{"abstract":[{"text":"The HIG contains guidance and best practices that can help you design a","type":"text"},{"text":" ","type":"text"},{"text":"great experience for any Apple platform.","type":"text"}],"identifier":"doc:\/\/com.apple.HIG\/design\/human-interface-guidelines","images":[{"identifier":"human-interface-guidelines-page-image-card.png","type":"card"}],"kind":"article","role":"collection","title":"Human Interface Guidelines","type":"topic","url":"\/design\/human-interface-guidelines"},"doc://com.apple.documentation/documentation/AppKit/NSSplitViewController":{"abstract":[{"text":"An object that manages an array of adjacent child views, and has a split view object for managing dividers between those views.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NSSplitViewController"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppKit\/NSSplitViewController","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NSSplitViewController"}],"role":"symbol","title":"NSSplitViewController","type":"topic","url":"\/documentation\/appkit\/nssplitviewcontroller"},"doc://com.apple.documentation/documentation/SwiftUI/ListStyle/sidebar":{"abstract":[{"text":"The list style that describes the behavior and appearance of a","type":"text"},{"text":" ","type":"text"},{"text":"sidebar list.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sidebar"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI16SidebarListStyleV","text":"SidebarListStyle"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/ListStyle\/sidebar","kind":"symbol","role":"symbol","title":"sidebar","type":"topic","url":"\/documentation\/swiftui\/liststyle\/sidebar"},"doc://com.apple.documentation/documentation/SwiftUI/NavigationSplitView":{"abstract":[{"text":"A view that presents views in two or three columns, where selections in","type":"text"},{"text":" ","type":"text"},{"text":"leading columns control presentations in subsequent columns.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NavigationSplitView"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/NavigationSplitView","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NavigationSplitView"}],"role":"symbol","title":"NavigationSplitView","type":"topic","url":"\/documentation\/swiftui\/navigationsplitview"},"doc://com.apple.documentation/documentation/SwiftUI/TabViewSt