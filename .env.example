# ── API Server (.NET / GraphQL) ───────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgres://sprint:changeme@localhost:5432/sprint?sslmode=disable
JWT_SECRET=changeme-use-a-long-random-string-in-production

# Public base URLs, as a browser or the desktop app reaches them. The API builds
# the Discord redirect URI (SPRINT_PUBLIC_API_URL + /api/auth/discord/callback)
# and engineer invite links (SPRINT_PUBLIC_WEB_URL + /engineer/invite/<token>)
# from these.
SPRINT_PUBLIC_API_URL=http://localhost:8080
SPRINT_PUBLIC_WEB_URL=http://localhost:3000

# Discord sign-in: on only when both are set. Create an application at
# https://discord.com/developers/applications and add the redirect URI above
# under OAuth2 -> Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Web App ───────────────────────────────────────────────────────────────────
# Where the web server calls the API, server-side only (default: http://localhost:8080).
# Every web setting is read at runtime; there are no NEXT_PUBLIC_* build-time values.
API_URL=http://localhost:8080

# ── Postgres (docker-compose, relational store) ───────────────────────────────
POSTGRES_DB=sprint
POSTGRES_USER=sprint
POSTGRES_PASSWORD=changeme

# ── InfluxDB (docker-compose, time-series telemetry store) ─────────────────────
# INFLUXDB_TOKEN is required by docker-compose (used to bootstrap InfluxDB and by
# the API to authenticate). Use a long random string in production.
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=changeme-influx-admin-token
INFLUXDB_ORG=sprint
INFLUXDB_BUCKET=telemetry
INFLUXDB_USERNAME=sprint
INFLUXDB_PASSWORD=changeme-influx

# ── Cloudflare Tunnel (optional, `--profile tunnel`) ──────────────────────────
# Token from Zero Trust > Networks > Tunnels > your tunnel. Only needed when
# publishing this stack through Cloudflare — see docs/operations/deployment.md.
# CLOUDFLARE_TUNNEL_TOKEN=
