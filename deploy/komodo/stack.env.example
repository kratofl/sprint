# Environment for deploy/komodo/compose.yaml. Paste into the Komodo stack's
# "Environment" field (or save as .env next to the compose file) and fill in.
#
# Replace every `replace-with-openssl-rand-hex-32` with its own value from
# `openssl rand -hex 32` (one run per secret). Hex on purpose: the Postgres
# password is embedded in a URL, where base64's `+`, `/` and `=` break it.
# Komodo Variables/Secrets work too, e.g. JWT_SECRET=[[SPRINT_JWT_SECRET]].

# ── Images ────────────────────────────────────────────────────────────────────
# Owner of ghcr.io/<owner>/sprint-api and sprint-web.
SPRINT_IMAGE_OWNER=kratofl
# unstable (latest pre-release), stable (latest release), edge (main), or an exact
# release tag such as v0.2.1-alpha.1 to pin. Every release so far is a pre-release,
# so `stable` does not exist yet; switch to it once a plain vX.Y.Z is tagged.
SPRINT_VERSION=unstable

# ── Public URLs ───────────────────────────────────────────────────────────────
# What browsers and the desktop app use to reach the stack. No trailing slash.
# Invite links and sign-in redirects are built from these, so they must be the
# real public addresses, not container names.
SPRINT_PUBLIC_WEB_URL=https://sprint.example.com
SPRINT_PUBLIC_API_URL=https://sprint-api.example.com

# ── Host ports ────────────────────────────────────────────────────────────────
# Only web and api are published. Point your reverse proxy (or the tunnel) here.
SPRINT_WEB_PORT=3000
SPRINT_API_PORT=8080

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs every session token. Changing it signs everyone out. openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Discord sign-in (optional; both set = on, either empty = email/password only).
# 1. https://discord.com/developers/applications -> New Application.
# 2. OAuth2 -> copy the Client ID; Reset Secret -> copy the Client Secret.
# 3. OAuth2 -> Redirects -> add exactly SPRINT_PUBLIC_API_URL + /api/auth/discord/callback
#    e.g. https://sprint-api.example.com/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Postgres (accounts, sessions, setups) ─────────────────────────────────────
# Read once, when the volume is first created. Changing the password later needs
# ALTER ROLE inside the database as well.
POSTGRES_DB=sprint
POSTGRES_USER=sprint
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# ── InfluxDB (telemetry) ──────────────────────────────────────────────────────
# Also first-start only: the admin token the API uses is set here once.
INFLUXDB_ORG=sprint
INFLUXDB_BUCKET=telemetry
INFLUXDB_USERNAME=sprint
INFLUXDB_PASSWORD=replace-with-openssl-rand-hex-32
INFLUXDB_TOKEN=replace-with-openssl-rand-hex-32

# ── Cloudflare Tunnel (optional) ──────────────────────────────────────────────
# Uncomment both to run cloudflared in the stack. Token: Zero Trust -> Networks ->
# Tunnels -> your tunnel. Public hostnames point at web:3000 and api:8080.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
